{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thefunkybits.github.io/rgm/spec/catalog-v4/signatures.schema.json",
  "title": "RGM immutable catalog release signatures",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestSha256", "signatures"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["algorithm", "keyId", "value"],
        "properties": {
          "algorithm": { "const": "ed25519" },
          "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
        }
      }
    }
  }
}
