{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thefunkybits.github.io/rgm/spec/catalog-v4/index.schema.json",
  "title": "RGM immutable catalog release index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "minimumAppVersionCode", "files"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 4 },
    "catalogVersion": { "type": "integer", "minimum": 1 },
    "minimumAppVersionCode": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "maxLength": 240
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "objectPath", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "objectPath": { "$ref": "#/$defs/path" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
