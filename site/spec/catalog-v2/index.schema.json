{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thefunkybits.github.io/rgm-publication/spec/catalog-v2/index.schema.json",
  "title": "RGM signed catalog index payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "catalogName", "revision", "generatedAt", "minimumAppVersionCode", "files"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "catalogId": { "$ref": "#/$defs/slug" },
    "catalogName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "revision": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "minimumAppVersionCode": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "maxLength": 240 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "objectPath", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "objectPath": { "$ref": "#/$defs/path" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
